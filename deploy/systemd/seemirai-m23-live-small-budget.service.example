[Unit]
Description=Seemirai M23 live small-budget autonomous segment
Documentation=file:/home/lim/code/seemirai/docs/runbooks/m23-live-small-budget-operations.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lim/code/seemirai
EnvironmentFile=%h/vaults/99_운영/seemirai-m22-live-autonomous/m22.env
EnvironmentFile=%h/vaults/99_운영/seemirai-m22-live-autonomous/m22.keys.env
Environment=SEEMIRAI_RUN_M22_AUTONOMOUS_PILOT=1
Environment=SEEMIRAI_RUN_M22_AUTONOMOUS_DAEMON=1
ExecStart=%h/vaults/99_운영/seemirai-m22-live-autonomous/run-24h-pilot.sh
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/vaults/99_운영/seemirai-m22-live-autonomous
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
