# production live ops credential example
# 실제 값은 저장소 밖 env 파일 또는 process manager secret으로만 주입한다.
SEEMIRAI_DATABASE_URL=postgres://seemirai:<db-password>@127.0.0.1:55432/seemirai
SEEMIRAI_UPBIT_ACCESS_KEY=<upbit-access-key>
SEEMIRAI_UPBIT_SECRET_KEY=<upbit-secret-key>
SEEMIRAI_TELEGRAM_BOT_TOKEN=<telegram-bot-token>
SEEMIRAI_TELEGRAM_CHAT_ID=<telegram-chat-id>
SEEMIRAI_TUI_CONTROL_TOKEN=<local-control-token>
