# Paper mode does not require Upbit API keys.
# Set SEEMIRAI_DATABASE_URL instead of the component values below when one full URL is easier.
# SEEMIRAI_DATABASE_URL=postgres://seemirai:seemirai_local_password@127.0.0.1:55432/seemirai_local
SEEMIRAI_ENV=local
SEEMIRAI_POSTGRES_HOST=127.0.0.1
SEEMIRAI_POSTGRES_DB=seemirai_local
SEEMIRAI_POSTGRES_USER=seemirai
SEEMIRAI_POSTGRES_PASSWORD=seemirai_local_password
SEEMIRAI_POSTGRES_PORT=55432
SEEMIRAI_LOCAL_CONTROL_TOKEN=
SEEMIRAI_TELEGRAM_BOT_TOKEN=
SEEMIRAI_TELEGRAM_CHAT_ID=
SEEMIRAI_TELEGRAM_INBOUND_ENABLED=0
SEEMIRAI_TELEGRAM_INBOUND_BOT_USERNAME=
SEEMIRAI_TELEGRAM_INBOUND_OWNER_CHAT_IDS=
SEEMIRAI_TELEGRAM_INBOUND_OWNER_USER_IDS=
SEEMIRAI_TELEGRAM_INBOUND_POLLING_INTERVAL_MS=1000
SEEMIRAI_TELEGRAM_INBOUND_POLLING_TIMEOUT_SECONDS=20
SEEMIRAI_TELEGRAM_INBOUND_MAX_UPDATES_PER_POLL=50
